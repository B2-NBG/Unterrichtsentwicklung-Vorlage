{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read",
      "Edit(./Unterricht/**)",
      "WebSearch"
    ],
    "deny": [
      "PowerShell",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(git config unterricht.werkzeug:*)",
      "Bash(git config --local unterricht.werkzeug:*)",
      "Bash(git config --global unterricht.werkzeug:*)",
      "Bash(git config --add unterricht.werkzeug:*)",
      "Bash(git config --replace-all unterricht.werkzeug:*)",
      "Edit(./.git/config)"
    ]
  }
}
