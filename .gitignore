__pycache__/
.DS_Store

# Kurssicherungen aus der Lernplattform (groß, können Fragen und Lösungen enthalten): nur lokal
Ressourcen/Kurssicherungen-Moodle/

# Arbeitsordner tmp/, nie versionieren (Bleibendes gehört nach Ressourcen/).
# Nur die leere Platzhalterdatei tmp/.gitkeep liegt in Git, damit der Ordner nach dem Klonen da ist.
tmp/*
!tmp/.gitkeep

# Feedback zu Schülerarbeiten bleibt lokal (Datenschutz)
Unterricht/**/*-Feedback/

# Lernpakete und Kurssicherungen liegen nicht in Git: GitHub baut sie nach dem Push aus Unterricht/ (Themenordner,
# Kurs-….json) und stellt sie zu (.github/workflows/paket-zustellen.yml). Lokal Gebautes landet im Temp-Ordner.
